{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cognitive-risk-dashboard-v2-medication-schema.json",
  "title": "Medication Dataset Schema",
  "type": "object",
  "required": ["dataset", "medicines"],
  "properties": {
    "dataset": {"type": "string"},
    "medicines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "scales", "categories", "badges", "notes", "ingredients"],
        "properties": {
          "name": {"type": "string"},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "scales": {
            "type": "object",
            "properties": {
              "acb": {"type": "object", "properties": {"score": {"type": "number"}}, "required": ["score"]},
              "aec": {"type": "object", "properties": {"score": {"type": "number"}}, "required": ["score"]}
            },
            "additionalProperties": true
          },
          "categories": {"type": "array", "items": {"type": "string"}},
          "badges": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"},
          "ingredients": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
